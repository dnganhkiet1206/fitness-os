  "guide.first.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your first session is for learning. Pick a weight you could lift 12 times with energy left — tap ○ after each set."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Buổi đầu là để làm quen. Chọn mức tạ nâng được 12 lần mà vẫn còn sức — xong một hiệp thì chạm ○."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La primera sesión es para aprender. Elige un peso que puedas levantar 12 veces con energía de sobra; toca ○ tras cada serie."
     }
    }
   }
  },
  "guide.first.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Koa is timing your rest — check the Dynamic Island. Next set when it's done."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Koa đang đếm giờ nghỉ — xem trên Đảo động. Nghỉ xong làm hiệp kế."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Koa cuenta tu descanso; míralo en la Dynamic Island. Siguiente serie al terminar."
     }
    }
   }
  },
  "guide.first.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No need to do it all: 2 sets per exercise is plenty today. Finish whenever you're ready."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Không cần làm hết: 2 hiệp mỗi bài là đủ cho buổi đầu. Chốt buổi khi bạn thấy đủ."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No hace falta todo: 2 series por ejercicio bastan hoy. Termina cuando quieras."
     }
    }
   }
  },
