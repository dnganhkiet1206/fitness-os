     }
    }
   }
  },
  "cm.intro": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Things you mentioned in past conversations, so Koa does not ask again. Daily numbers are not here — the app already has those."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Những điều bạn đã kể trong các cuộc trò chuyện, để Koa không hỏi lại. Số liệu hằng ngày không nằm ở đây — app đã có sẵn."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que mencionaste en conversaciones anteriores, para que Koa no vuelva a preguntar. Los datos diarios no están aquí: la app ya los tiene."
     }
    }
   }
  },
  "cm.loadFailed": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
