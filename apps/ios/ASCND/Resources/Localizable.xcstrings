  "bioLog.baselineNote": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Resting HR and HRV are scored against your own baseline, so it takes 5 readings within 28 days before they appear on the readiness card. Entering them by hand counts exactly like Apple Health — no watch needed."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Nhịp tim nghỉ và HRV được chấm so với nền của chính bạn, nên cần 5 lần đo trong 28 ngày mới hiện lên thẻ điểm sẵn sàng. Nhập tay tính y như Apple Health — không cần đồng hồ."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La FC en reposo y la HRV se puntúan contra tu propia base, así que se necesitan 5 lecturas en 28 días antes de que aparezcan en la tarjeta de preparación. Ingresarlas a mano cuenta igual que Apple Health — no necesitas reloj."
     }
    }
   }
  },
