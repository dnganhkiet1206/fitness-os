  "wb.effort.hint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "RPE = how many more reps you could do before failure: 10 means not one more, 8 means about 2 left. It is not pain — stop if a joint hurts or you feel a sharp pain."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "RPE = còn bao nhiêu rep nữa thì thất bại: 10 là không thêm được rep nào, 8 là còn khoảng 2. Không phải mức đau — đau khớp hay nhói thì dừng lại."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "RPE = cuántas repeticiones más podrías hacer antes del fallo: 10 es ni una más, 8 es unas 2 más. No es dolor: si duele una articulación o sientes un pinchazo, para."
     }
    }
   }
  },
