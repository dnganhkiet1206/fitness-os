  "community.privacy.notifyhint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Turning one off stops that notification from being created. What other people do, like liking or saving, still happens."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Tắt một mục thì thông báo ấy không được tạo nữa. Việc của người khác, như thích hay lưu bài, vẫn diễn ra như thường."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si desactivas una opción, esa notificación deja de crearse. Lo que hacen los demás, como dar me gusta o guardar, sigue ocurriendo."
