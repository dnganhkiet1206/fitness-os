  "tc.advice.detraining": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A long gap costs you your base. Come back gradually — do not try to make up the missed weeks."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Nghỉ lâu làm mất nền thể lực. Quay lại từ từ — đừng tập bù cho những tuần đã nghỉ."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un parón largo te hace perder la base. Vuelve poco a poco: no intentes recuperar las semanas perdidas."
     }
    }
   }
  },
  "tc.advice.low": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lighter than usual. One easier week is normal, and useful."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Nhẹ hơn thường lệ. Một tuần giảm tải là bình thường và có ích."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Más ligera de lo habitual. Una semana más suave es normal y útil."
     }
    }
   }
  },
  "tc.advice.optimal": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Progressing at a sensible rate. Keep this up."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Đang tăng ở mức hợp lý. Cứ giữ nhịp này."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Progresas a un ritmo sensato. Sigue así."
     }
    }
   }
  },
  "tc.advice.elevated": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ramping up quickly. Hold this volume next week rather than adding more."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Tăng hơi nhanh. Tuần tới nên giữ nguyên khối lượng thay vì tăng tiếp."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estás subiendo rápido. La próxima semana mantén este volumen en vez de añadir más."
     }
    }
   }
  },
  "tc.advice.spike": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A sharp jump is when injuries happen. Ease off next week."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Tăng vọt là lúc dễ chấn thương nhất. Tuần tới nên giảm tải."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un salto brusco es cuando llegan las lesiones. Afloja la próxima semana."
     }
    }
   }
  },
