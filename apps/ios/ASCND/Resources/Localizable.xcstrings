  "workout.unsaved": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Couldn't save to this device yet — your sets are visible but not durable. They'll save when the device write succeeds."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Chưa lưu được xuống máy — các set vẫn hiện nhưng chưa bền. Sẽ lưu khi lần ghi máy thành công."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no se pudo guardar en el dispositivo — las series se ven pero no son duraderas. Se guardarán cuando la escritura tenga éxito."
