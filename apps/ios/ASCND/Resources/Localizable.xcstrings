    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Hiện các thử thách bạn đã hoàn thành trên hồ sơ cộng đồng. Tắt thì không ai thấy — kể cả trên hồ sơ của chính bạn."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Muestra los retos que completaste en tu perfil de comunidad. Desactivado significa que nadie las ve — ni siquiera en tu propio perfil."
     }
    }
   }
  },
