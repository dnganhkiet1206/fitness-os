  "cm.forget.title": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Forget this?"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Quên điều này?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Olvidar esto?"
     }
    }
   }
  },
  "cm.forget.message %@": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”\n\nKoa will no longer remember this. If it is still true, you can mention it again in a conversation."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”\n\nKoa sẽ không còn nhớ điều này. Nếu nó vẫn đúng, bạn có thể kể lại trong một cuộc trò chuyện."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”\n\nKoa ya no recordará esto. Si sigue siendo cierto, puedes volver a mencionarlo en una conversación."
     }
    }
   }
  },
