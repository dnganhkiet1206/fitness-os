  "community.privacy.blockedhint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "People you block can't see your posts, and you won't see theirs. Unblocking doesn't follow them again."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Người bị chặn không thấy bài của bạn, và bạn không thấy bài của họ. Bỏ chặn không tự theo dõi lại."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las personas que bloquees no pueden ver tus publicaciones, y tú no verás las suyas. Al desbloquearlas no las seguirás de nuevo."
     }
    }
   }
  },
