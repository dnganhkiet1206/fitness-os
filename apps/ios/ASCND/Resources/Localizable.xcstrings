  "cm.forget.title": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Forget this?"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Quên điều này?"
     }
    },
    "es": {
