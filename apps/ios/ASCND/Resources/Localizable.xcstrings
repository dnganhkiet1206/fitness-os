  "cm.title": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What Koa remembers"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Koa nhớ gì"
     }
