      "value": "¿Olvidar esto?"
     }
    }
   }
  },
  "cm.forget.message %@": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”\n\nThe coach will no longer remember this. If it is still true, you can mention it again in a conversation."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”\n\nCoach sẽ không còn nhớ điều này. Nếu nó vẫn đúng, bạn có thể kể lại trong một cuộc trò chuyện."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”\n\nEl coach ya no recordará esto. Si sigue siendo cierto, puedes volver a mencionarlo en una conversación."
     }
    }
   }
  },
