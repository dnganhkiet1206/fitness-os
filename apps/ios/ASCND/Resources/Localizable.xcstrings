  "cm.title": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What the coach remembers"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Coach nhớ gì"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que recuerda el coach"
     }
    }
   }
  },
  "cm.intro": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Things you mentioned in past conversations, so the coach does not ask again. Daily numbers are not here — the app already has those."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Những điều bạn đã kể trong các cuộc trò chuyện, để coach không hỏi lại. Số liệu hằng ngày không nằm ở đây — app đã có sẵn."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que mencionaste en conversaciones anteriores, para que el coach no vuelva a preguntar. Los datos diarios no están aquí: la app ya los tiene."
     }
    }
   }
  },
  "cm.loadFailed": {
   "extractionState": "manual",
   "localizations": {
