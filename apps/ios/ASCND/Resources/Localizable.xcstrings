  "onboarding.schedule.why": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Koa builds your week. New to training? 3 days is plenty — enough to grow, with time to recover."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Koa lên lịch tuần cho bạn. Mới tập thì 3 buổi là vừa — đủ để Koa lớn mà vẫn kịp hồi phục."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Koa arma tu semana. Si estás empezando, 3 días bastan: suficiente para crecer y recuperarte."
     }
    }
