  "settings.delete.title": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Delete your account permanently?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Eliminar tu cuenta de forma permanente?"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Xoá tài khoản vĩnh viễn?"
     }
    }
   }
  },
  "settings.delete.message": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Everything will be deleted for good — meals, workouts, sleep, progress photos, community posts, messages and what Koa remembers. This cannot be undone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se eliminará todo para siempre: comidas, entrenamientos, sueño, fotos de progreso, publicaciones, mensajes y lo que Koa recuerda. No se puede deshacer."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Mọi dữ liệu sẽ bị xoá vĩnh viễn — bữa ăn, buổi tập, giấc ngủ, ảnh tiến trình, bài đăng cộng đồng, tin nhắn và những gì Koa nhớ. Không thể hoàn tác."
     }
    }
   }
  },
  "settings.delete.confirm": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Delete permanently"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Eliminar para siempre"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Xoá vĩnh viễn"
     }
    }
   }
  },
  "settings.delete.failed": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your account was not deleted and nothing was removed. Please try again later."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cuenta no se eliminó y no se borró nada. Inténtalo de nuevo más tarde."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Chưa xoá được tài khoản, chưa có dữ liệu nào bị xoá. Hãy thử lại sau."
     }
    }
   }
  },
  "settings.delete.partial": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your progress photos were deleted but the account is not fully deleted yet. Try again to finish."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus fotos de progreso se eliminaron, pero la cuenta aún no se ha eliminado por completo. Inténtalo de nuevo para terminar."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Ảnh tiến trình đã bị xoá nhưng tài khoản chưa xoá xong. Hãy thử lại để hoàn tất."
     }
    }
   }
  },
  "settings.delete.offline": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No connection. Connect and try again — nothing was deleted."
     }
    },
    "es": {
     "stringUnit": {
