     "stringUnit": {
      "state": "translated",
      "value": "ACWR slightly high (%@). Cut 5-10%% volume or drop 1-2 sets per exercise."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "ACWR hơi cao (%@). Giảm 5-10%% volume hoặc bớt 1-2 sets/bài tập."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "ACWR algo alto (%@). Reduce un 5-10%% el volumen o quita 1-2 series por ejercicio."
     }
    }
   }
  },
