  "ep.activity.note": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This already includes your training, so the app does not add calories back after a session — doing that would count the same hour twice."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Mức này đã tính cả việc tập, nên app không cộng thêm calo sau mỗi buổi tập — cộng nữa là tính một giờ hai lần."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esto ya incluye tu entrenamiento, así que la app no suma calorías después de una sesión — hacerlo contaría la misma hora dos veces."
