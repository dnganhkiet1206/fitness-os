  "onboarding.error.duplicate": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This is already saved — no need to add it twice."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
