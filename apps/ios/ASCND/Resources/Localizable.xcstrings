  "lab.hint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Debug only. Start a rest, lock the phone or go home, then press ±15 on the Dynamic Island: the number here and on the Island must match, and the Island ring must move smoothly."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Chỉ có ở bản Debug. Bắt đầu nghỉ, khoá máy hoặc về màn chính, rồi bấm ±15 trên Dynamic Island: số ở đây và trên Island phải khớp nhau, và vòng trên Island phải chạy mượt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Solo en depuración. Inicia un descanso, bloquea el teléfono o ve al inicio y pulsa ±15 en la Dynamic Island: el número aquí y en la Isla debe coincidir, y el anillo de la Isla debe moverse con suavidad."
     }
    }
   }
  },
