    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Tôi là AI Coach — tôi phân tích dữ liệu tập luyện, dinh dưỡng, giấc ngủ và phục hồi của bạn để đưa ra lời khuyên cá nhân hoá."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Soy tu entrenador IA — analizo tus datos de entrenamiento, nutrición, sueño y recuperación para darte consejos personalizados."
     }
    }
   }
  },
