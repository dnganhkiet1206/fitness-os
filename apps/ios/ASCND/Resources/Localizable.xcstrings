  "plans.what": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A meal plan is a week of meals you set up ahead. Open a day, tap “Log to today”, and that meal goes into today’s diary."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Kế hoạch ăn là một tuần các bữa bạn soạn trước. Mở một ngày, chạm “Ghi vào hôm nay” là bữa đó vào nhật ký hôm nay."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un plan de comidas es una semana de comidas que preparas con antelación. Abre un día, toca “Registrar hoy” y esa comida pasa al diario de hoy."
     }
    }
   }
  },
