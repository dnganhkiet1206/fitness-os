  "coach.intro": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I'm Koa, your coach — I read your training, nutrition, sleep and recovery data to give you personal advice."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Mình là Koa, coach của bạn — mình đọc dữ liệu tập luyện, dinh dưỡng, giấc ngủ và phục hồi để đưa ra lời khuyên dành riêng cho bạn."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Soy Koa, tu coach — leo tus datos de entrenamiento, nutrición, sueño y recuperación para darte consejos personalizados."
     }
    }
   }
  },
