  "community.profile.rules": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "By creating a profile you agree to the Community Rules: no tolerance for objectionable, abusive or harmful content. Violations are removed and accounts can be suspended."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Khi tạo hồ sơ, bạn đồng ý với Quy tắc cộng đồng: không dung thứ nội dung phản cảm, quấy rối hay gây nguy hiểm. Nội dung vi phạm bị gỡ và tài khoản có thể bị khoá."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al crear un perfil aceptas las Normas de la comunidad: tolerancia cero con el contenido ofensivo, abusivo o dañino. Las infracciones se eliminan y las cuentas pueden suspenderse."
     }
    }
   }
  },
