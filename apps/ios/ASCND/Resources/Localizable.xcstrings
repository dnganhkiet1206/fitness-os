  "onboarding.error.statsRequired": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A valid height, weight and date of birth are needed first"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Cần chiều cao, cân nặng và ngày sinh hợp lệ trước khi tính"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Primero se necesitan estatura, peso y fecha de nacimiento válidos"
     }
    }
   }
  },
  "onboarding.error.onlineOnly": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No connection — not sent, and not kept to send later."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Không có kết nối — chưa gửi, và không giữ lại để gửi sau."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sin conexión — no enviado ni guardado para enviar después."
     }
    }
   }
  },
  "onboarding.error.duplicate": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This is already saved — no need to add it twice."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Mục này đã được lưu rồi — không cần thêm lần nữa."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esto ya está guardado — no hace falta añadirlo dos veces."
     }
    }
   }
  },
  "onboarding.error.invalid": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "That value could not be saved. Check it and try again."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Giá trị này chưa lưu được. Kiểm tra lại rồi thử lần nữa."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ese valor no se pudo guardar. Revísalo e inténtalo de nuevo."
     }
    }
   }
  },
  "onboarding.error.signedOut": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your session has expired. Sign in again and try once more."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Phiên đăng nhập đã hết hạn. Hãy đăng nhập lại rồi thử lần nữa."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu sesión ha expirado. Inicia sesión de nuevo e inténtalo otra vez."
     }
    }
   }
  },
  "onboarding.error.notFound": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This is no longer here. Refresh and have another look."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Mục này không còn ở đây. Tải lại rồi xem lại giúp bạn nhé."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esto ya no está aquí. Actualiza y vuelve a mirar."
     }
    }
   }
  },
  "onboarding.error.server": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The server had a problem. Nothing was lost — try again in a moment."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Máy chủ đang gặp sự cố. Không mất gì cả — thử lại sau một chút."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El servidor tuvo un problema. No se perdió nada — inténtalo de nuevo en un momento."
     }
    }
