  "ps.about.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "“Good” and “Needs attention” compare your last 7 days with your own goals. Missing data is shown as missing — Koa doesn't guess."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "“Tốt”, “Cần chú ý” so số 7 ngày gần nhất với mục tiêu của chính bạn. Thiếu dữ liệu thì ghi là thiếu — Koa không đoán."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "“Bien” y “Requiere atención” comparan tus últimos 7 días con tus propias metas. Si faltan datos, se indica: Koa no adivina."
     }
    }
   }
  },
