  "tx.bothEnds": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Both ends are red. Training too little is flagged as well as too much — losing your base is what makes coming back risky."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Cả hai đầu đều đỏ. Tập quá ít cũng bị cảnh báo chứ không riêng tập quá nhiều — mất nền thể lực là thứ khiến bạn dễ chấn thương khi quay lại."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los dos extremos están en rojo. Se avisa tanto de entrenar demasiado poco como demasiado: perder la base es lo que hace arriesgada la vuelta."
     }
    }
   }
  },
  "tx.latest.title": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The latest session"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Buổi gần nhất"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La última sesión"
     }
    }
   }
  },
  "tx.latest.when.term": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Today / 5 days ago"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Hôm nay / 5 ngày trước"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hoy / hace 5 días"
     }
    }
   }
  },
  "tx.latest.when.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "How long ago the most recent session was. Past seven days it turns amber and the card says so, because at that point every \"7 days\" figure below is legitimately zero rather than broken."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Buổi gần nhất được ghi cách đây bao lâu. Nếu quá 7 ngày, chữ chuyển sang vàng và thẻ nói rõ — vì lúc đó mọi con số \"7 ngày\" bên dưới đều bằng 0 một cách chính đáng, chứ không phải hỏng."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hace cuánto fue la sesión más reciente. Pasados siete días se vuelve ámbar y la tarjeta lo dice, porque entonces cada cifra de «7 días» es cero con razón, no por un fallo."
     }
    }
   }
  },
  "tx.latest.sets.term": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "12 sets"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "12 set"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "12 series"
     }
    }
   }
  },
  "tx.latest.sets.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "How many sets were logged in that session. Warm-ups count only if you logged them."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Số set đã ghi trong buổi đó. Khởi động chỉ được tính nếu bạn có ghi lại."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuántas series se registraron en esa sesión. El calentamiento solo cuenta si lo registraste."
     }
    }
   }
  },
  "tx.latest.effort.term": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Effort 8/10"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Gắng sức 8/10"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esfuerzo 8/10"
     }
    }
   }
  },
  "tx.latest.effort.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "How hard the session was, 1–10 (elsewhere called RPE). 8 means about two reps left in the tank, 10 means nothing left. You set this; the app cannot measure it."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Mức gắng sức của cả buổi, thang 1–10 (nơi khác gọi là RPE). 8 nghĩa là còn khoảng 2 rep nữa mới hết sức, 10 là không còn gì. Đây là số bạn tự chấm, app không đo được."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo dura que fue la sesión, del 1 al 10 (en otros sitios, RPE). 8 significa que te quedaban unas dos repeticiones; 10, que no te quedaba nada. Lo pones tú; la app no puede medirlo."
     }
    }
   }
  },
  "tx.latest.volume.term": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "4,200 kg"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "4.200 kg"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "4.200 kg"
     }
    }
   }
  },
  "tx.latest.volume.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "NOT the weight you lifted. It is tonnage: weight × reps, summed over every set. 60kg × 10 reps × 3 sets = 1,800 kg. Numbers in the thousands are normal. It measures what you LIFTED, so a session of pull-ups or press-ups comes to 0 — which is why it is not the number the week-versus-habit comparison uses."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "KHÔNG phải mức tạ bạn nâng. Đây là tổng khối lượng: cộng (tạ × số rep) của từng set. 60kg × 10 rep × 3 set = 1.800 kg. Nên số hàng nghìn là bình thường. Nó đo thứ bạn NÂNG, nên một buổi hít xà hay chống đẩy ra 0 — đó là lý do nó không phải con số dùng để so tuần này với thói quen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "NO es el peso que levantaste. Es el tonelaje: peso × repeticiones, sumado en cada serie. 60 kg × 10 repeticiones × 3 series = 1.800 kg. Las cifras de miles son normales. Mide lo que LEVANTASTE, así que una sesión de dominadas o flexiones da 0: por eso no es el número que usa la comparación de la semana con tu hábito."
     }
    }
   }
  },
  "tx.latest.load.term": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Load 2,400"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Tải 2.400"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Carga 2.400"
     }
    }
   }
  },
  "tx.latest.load.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The number the week-versus-habit comparison uses. Session effort × total reps: effort 8 × 300 reps = 2,400. It measures what the session cost YOUR BODY, so a bodyweight session still has a load — unlike tonnage, which is zero without weights. It has no unit and needs none: it only means anything against your own recent sessions."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Con số dùng để so tuần này với thói quen. Bằng mức gắng sức của buổi nhân tổng số rep: gắng sức 8 × 300 rep = 2.400. Nó đo buổi tập tốn gì với CƠ THỂ bạn, nên một buổi tay không vẫn có tải — khác với tổng khối lượng, vốn bằng 0 khi không có tạ. Không có đơn vị, và cũng không cần: nó chỉ có nghĩa khi so với chính các buổi gần đây của bạn."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El número que usa la comparación de la semana con tu hábito. Esfuerzo de la sesión × repeticiones totales: esfuerzo 8 × 300 repeticiones = 2.400. Mide lo que la sesión le costó a TU CUERPO, así que una sesión con tu propio peso también tiene carga, a diferencia del tonelaje, que es cero sin pesas. No tiene unidad ni la necesita: solo significa algo frente a tus propias sesiones recientes."
     }
    }
   }
  },
  "tx.latest.noload.term": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A session with no load"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Buổi không có tải"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una sesión sin carga"
     }
    }
   }
  },
  "tx.latest.noload.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sessions imported from a watch (a run, a ride) have no effort rating and no reps, so the app does not compute a load for them — and does not treat them as zero. They are dropped from both sides of the comparison, because \"not measurable\" is not the same as \"cost nothing\"."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Buổi nhập từ đồng hồ (chạy bộ, đạp xe) không có mức gắng sức bạn tự chấm và cũng không có rep, nên app KHÔNG tính tải cho nó — và không coi nó bằng 0. Nó được bỏ khỏi cả hai vế của phép so, vì \"không đo được\" khác với \"tốn 0\"."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las sesiones importadas de un reloj (una carrera, una salida en bici) no tienen esfuerzo ni repeticiones, así que la app no les calcula carga, y tampoco las cuenta como cero. Se quitan de los dos lados de la comparación, porque «no medible» no es lo mismo que «no costó nada»."
     }
    }
   }
  },
  "tx.latest.strength.term": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Strength days 2/3"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Ngày tập cơ 2/3"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Días de fuerza 2/3"
     }
    }
   }
  },
  "tx.latest.strength.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "How many DAYS in the last 7 you did strength work, and what your goal aims at. Counted in days, not sessions: two sessions on the same day is still one day. The floor is 2 days a week — the WHO recommendation for every adult, including while training for endurance; a strength or muscle-gain goal aims at 3. A run imported from a watch does not count here, because it is not strength work."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Số NGÀY trong 7 ngày qua bạn có tập cơ, và mức mục tiêu của bạn nhắm tới. Đếm theo ngày chứ không theo buổi: hai buổi cùng một ngày vẫn là một ngày. Mức tối thiểu là 2 ngày/tuần — khuyến nghị của WHO cho mọi người lớn, kể cả khi bạn đang tập vì sức bền; mục tiêu sức mạnh hoặc tăng cơ nhắm tới 3. Buổi chạy nhập từ đồng hồ không tính vào đây vì nó không phải tập cơ."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuántos DÍAS de los últimos 7 hiciste trabajo de fuerza, y a qué apunta tu objetivo. Se cuentan días, no sesiones: dos sesiones el mismo día siguen siendo un día. El mínimo es 2 días por semana, la recomendación de la OMS para todo adulto, también si entrenas resistencia; un objetivo de fuerza o de ganar músculo apunta a 3. Una carrera importada de un reloj no cuenta aquí, porque no es trabajo de fuerza."
     }
    }
   }
  },
  "tx.markers.title": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Two more markers"
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai dấu hiệu còn lại"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dos indicadores más"
     }
    }
   }
  },
  "tx.pr.body": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A session in the last 7 days hit a personal record on at least one lift."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Có một buổi trong 7 ngày qua đạt kỷ lục cá nhân ở ít nhất một bài."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una sesión de los últimos 7 días batió un récord personal en al menos un ejercicio."
     }
    }
   }
  },
  "tx.caveat": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every number here comes from what you logged. A session you did not record does not exist to this card — the load falls even though you trained."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Mọi con số ở đây tính từ những gì bạn đã ghi. Buổi tập không ghi thì không tồn tại với thẻ này — đà tập sẽ tụt dù bạn vẫn đang tập."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada número sale de lo que registraste. Una sesión que no registraste no existe para esta tarjeta: la carga baja aunque hayas entrenado."
     }
    }
   }
  },
