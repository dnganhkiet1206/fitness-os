  "dp.comeback.tip.asBefore": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Short break: train like last time."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Nghỉ ngắn: tập như lần trước là được."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa corta: entrena como la última vez."
     }
    }
   }
  },
  "dp.comeback.tip.lighter": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Over a week off: we suggest one set fewer per exercise today."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Nghỉ hơn một tuần: gợi ý bớt 1 hiệp mỗi bài cho buổi này."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Más de una semana sin entrenar: te sugerimos una serie menos por ejercicio hoy."
     }
    }
   }
  },
  "dp.comeback.tip.short": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Four weeks or more off: we suggest a short session, the first half of the exercises, to ease back in."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Nghỉ từ 4 tuần: gợi ý buổi ngắn, nửa số bài đầu, để quen lại."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuatro semanas o más sin entrenar: te sugerimos una sesión corta, la primera mitad de los ejercicios, para retomar."
     }
    }
   }
  },
