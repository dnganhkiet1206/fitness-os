  "community.privacy.discoverhint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Only changes what you see in Discover and \"Useful this week\". Following still shows everything from people you follow. Keep at least one type on."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Chỉ đổi những gì bạn thấy ở Khám phá và \"Hữu ích tuần này\". \"Đang theo dõi\" vẫn hiện mọi bài của người bạn theo dõi. Giữ ít nhất một loại."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Solo cambia lo que ves en Descubrir y en «Útil esta semana». «Siguiendo» sigue mostrando todo de las personas que sigues. Deja al menos un tipo activado."
     }
    }
   }
