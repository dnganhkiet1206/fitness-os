  "cm.empty.message": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The coach remembers durable things — an injury, a food you avoid, when you train, what you are working towards. It skips anything that changes day to day."
     }
    },
    "vi": {
     "stringUnit": {
      "state": "translated",
      "value": "Coach sẽ ghi nhớ khi bạn kể những điều bền lâu — chấn thương, món không ăn được, lịch tập, mục tiêu. Nó bỏ qua những thứ đổi theo ngày."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El coach recuerda cosas duraderas: una lesión, un alimento que evitas, cuándo entrenas, hacia qué trabajas. Ignora lo que cambia de un día a otro."
     }
    }
   }
  },
