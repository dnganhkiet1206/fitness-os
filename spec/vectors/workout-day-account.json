[
  {"rule": "WDA-1 A ghi ngày → B không đọc được; B có ngày riêng cùng khoá; A quay lại thấy đúng của A",
   "note": "Đổi thẳng tài khoản (không qua đăng xuất). Khoá ngày đã chốt của A không chặn B.",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0"], "expect": "ok"},
     {"op": "finish", "day": "2026-10-05", "session": "s-a", "done": ["0-0"], "expect": "ok"},
     {"op": "signIn", "user": "b"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "save", "day": "2026-10-05", "done": ["0-1"], "expect": "ok"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-1"], "loggedSessionId": null}},
     {"op": "finish", "day": "2026-10-05", "session": "s-b", "done": ["0-1"], "expect": "ok"},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-0"], "loggedSessionId": "s-a", "loggedKeys": ["0-0"]}},
     {"op": "signIn", "user": "b"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-1"], "loggedSessionId": "s-b", "loggedKeys": ["0-1"]}}
   ]},
   "expected": {"owners": ["a", "b"], "outbox": ["s-a", "s-b"]}},
  {"rule": "WDA-2 A đăng xuất → lượt ghi muộn của A bị từ chối trước khi có gì bền",
   "note": "Chỉ đóng chốt (chưa dọn): A đăng nhập lại thấy trạng thái TRƯỚC lượt ghi muộn.",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0"], "expect": "ok"},
     {"op": "signOut"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "save", "day": "2026-10-05", "done": ["0-0", "0-1"], "expect": "closed"},
     {"op": "finish", "day": "2026-10-05", "session": "late", "done": ["0-0", "0-1"], "expect": "closed"},
     {"op": "delete", "session": "late", "expect": "closed"},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-0"], "loggedSessionId": null}}
   ]},
   "expected": {"owners": ["a"], "outbox": []}},
  {"rule": "WDA-3 Đăng xuất có dọn (RN clearUserScopedStorage, #241) → lượt ghi muộn không dựng lại ngày",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0"], "expect": "ok"},
     {"op": "signOut"},
     {"op": "clearAll", "expect": 1},
     {"op": "save", "day": "2026-10-05", "done": ["0-0", "0-1"], "expect": "closed"},
     {"op": "finish", "day": "2026-10-05", "session": "late", "done": ["0-0"], "expect": "closed"},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": null}
   ]},
   "expected": {"owners": [], "outbox": []}},
  {"rule": "WDA-4 B đăng nhập sau A → B tạo và chốt cùng khoá ngày độc lập",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "finish", "day": "2026-10-05", "session": "s-a", "done": ["0-0"], "expect": "ok"},
     {"op": "signOut"},
     {"op": "signIn", "user": "b"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "finish", "day": "2026-10-05", "session": "s-b", "done": ["0-0", "0-1"], "expect": "ok"},
     {"op": "finish", "day": "2026-10-05", "session": "s-b2", "done": ["0-0"], "expect": "dayAlreadyLogged"},
     {"op": "delete", "session": "s-a", "expect": "ok"},
     {"op": "load", "day": "2026-10-05", "expect": {"loggedSessionId": "s-b", "loggedKeys": ["0-0", "0-1"]}},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": {"loggedSessionId": "s-a", "loggedKeys": ["0-0"]}}
   ]},
   "expected": {"owners": ["a", "b"], "outbox": ["s-a", "s-a@del", "s-b"]}},
  {"rule": "WDA-5 Kill / mở lại ở mỗi ranh giới: mở app là chốt đóng; mỗi người thấy đúng của mình",
   "note": "`reopen` = mở lại cùng tệp như AppServices lúc khởi động: chốt đóng cho tới khi có phiên.",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0", "0-1"], "expect": "ok"},
     {"op": "reopen"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "save", "day": "2026-10-05", "done": ["0-0"], "expect": "closed"},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-0", "0-1"]}},
     {"op": "signOut"},
     {"op": "reopen"},
     {"op": "signIn", "user": "b"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "finish", "day": "2026-10-05", "session": "s-b", "done": ["1-0"], "expect": "ok"},
     {"op": "reopen"},
     {"op": "signIn", "user": "B"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["1-0"], "loggedSessionId": "s-b"}},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-0", "0-1"], "loggedSessionId": null}}
   ]},
   "expected": {"owners": ["a", "b"], "outbox": ["s-b"]}},
  {"rule": "WDA-6 Hàng cũ không chủ (v3) được giữ nhưng không bao giờ gán cho ai",
   "note": "Không chốt (unrestricted), A, rồi B: không ai đọc được; khoá đã chốt của hàng cũ không chặn ai; xoá của A không chạm nó.",
   "input": {"legacy": [{"day": "2026-10-05", "state": {"done": ["0-0"], "loggedSessionId": "legacy-s", "loggedKeys": ["0-0"]}}, {"day": "2026-09-05", "state": {"done": ["0-0"]}}],
    "steps": [
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "finish", "day": "2026-10-05", "session": "mine", "done": ["0-1"], "expect": "ok"},
     {"op": "delete", "session": "legacy-s", "expect": "ok"},
     {"op": "raw", "owner": "#legacy", "day": "2026-10-05", "expect": {"done": ["0-0"], "loggedSessionId": "legacy-s", "loggedKeys": ["0-0"]}},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-1"], "loggedSessionId": "mine"}},
     {"op": "signIn", "user": "b"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "load", "day": "2026-09-05", "expect": null},
     {"op": "prune", "today": "2026-10-05", "expect": 0}
   ]},
   "expected": {"owners": ["#legacy", "#legacy", "a"], "outbox": ["legacy-s@del", "mine"]}},
  {"rule": "WDA-7 Hai controller cùng chốt một ngày của cùng người: một thắng, một DayAlreadyLogged",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "race", "day": "2026-10-05", "sessions": ["s1", "s2"], "expect": {"ok": 1, "dayAlreadyLogged": 1}},
     {"op": "signIn", "user": "b"},
     {"op": "race", "day": "2026-10-05", "sessions": ["s3", "s4"], "expect": {"ok": 1, "dayAlreadyLogged": 1}}
   ]},
   "expected": {"owners": ["a", "b"], "outboxCount": 2}},
  {"rule": "WDA-8 Chốt lại cùng buổi là idempotent; buổi khác cùng ngày bị khoá",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "finish", "day": "2026-10-05", "session": "s1", "done": ["0-0"], "expect": "ok"},
     {"op": "finish", "day": "2026-10-05", "session": "s1", "done": ["0-0"], "expect": "ok"},
     {"op": "finish", "day": "2026-10-05", "session": "s2", "done": ["0-0"], "expect": "dayAlreadyLogged"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0", "0-1"], "expect": "dayAlreadyLogged"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-0"], "loggedSessionId": "s1"}}
   ]},
   "expected": {"owners": ["a"], "outbox": ["s1"]}},
  {"rule": "WDA-9 Dọn 14 ngày chỉ của người đang đăng nhập; không ai đăng nhập thì từ chối",
   "note": "#469: dọn chạy khi phiên mở, cho đúng người. Ngày thứ 14 trở về trước là quá hạn.",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "save", "day": "2026-09-21", "done": ["0-0"], "expect": "ok"},
     {"op": "save", "day": "2026-09-22", "done": ["0-0"], "expect": "ok"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0"], "expect": "ok"},
     {"op": "signIn", "user": "b"},
     {"op": "save", "day": "2026-09-15", "done": ["0-0"], "expect": "ok"},
     {"op": "save", "day": "2026-10-05", "done": ["0-1"], "expect": "ok"},
     {"op": "signOut"},
     {"op": "prune", "today": "2026-10-05", "expect": "closed"},
     {"op": "signIn", "user": "a"},
     {"op": "prune", "today": "2026-10-05", "expect": 1},
     {"op": "load", "day": "2026-09-21", "expect": null},
     {"op": "load", "day": "2026-09-22", "expect": {"done": ["0-0"]}},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-0"]}},
     {"op": "signIn", "user": "b"},
     {"op": "load", "day": "2026-09-15", "expect": {"done": ["0-0"]}},
     {"op": "prune", "today": "2026-10-05", "expect": 1},
     {"op": "load", "day": "2026-09-15", "expect": null},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-1"]}}
   ]},
   "expected": {"owners": ["a", "a", "b"], "outbox": []}},
  {"rule": "WDA-10 Lượt ghi muộn của A tới khi B đã đăng nhập: từ chối trước khi có gì bền, không lọt vào ngày của B",
   "note": "#454. `as` = người mà phép ghi nói nó ghi cho (controller cũ của A).",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0"], "expect": "ok"},
     {"op": "finish", "day": "2026-10-04", "session": "s-a", "done": ["0-0"], "expect": "ok"},
     {"op": "signIn", "user": "b"},
     {"op": "save", "day": "2026-10-05", "done": ["0-0", "0-1"], "as": "a", "expect": "closed"},
     {"op": "finish", "day": "2026-10-05", "session": "late", "done": ["0-0", "0-1"], "as": "a", "expect": "closed"},
     {"op": "delete", "session": "s-a", "as": "a", "expect": "closed"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "save", "day": "2026-10-05", "done": ["1-0"], "as": "B", "expect": "ok"},
     {"op": "save", "day": "2026-10-05", "done": ["1-0"], "as": "", "expect": "closed"},
     {"op": "signIn", "user": "a"},
     {"op": "load", "day": "2026-10-05", "expect": {"done": ["0-0"], "loggedSessionId": null}},
     {"op": "load", "day": "2026-10-04", "expect": {"loggedSessionId": "s-a", "loggedKeys": ["0-0"]}}
   ]},
   "expected": {"owners": ["a", "a", "b"], "outbox": ["s-a"]}},
  {"rule": "WDA-11 Thử lại chốt: lượt thử lại dưới phiên người khác bị từ chối, không nhân đôi; về đúng người thì idempotent",
   "input": {"steps": [
     {"op": "signIn", "user": "a"},
     {"op": "finish", "day": "2026-10-05", "session": "s1", "done": ["0-0"], "expect": "ok"},
     {"op": "signIn", "user": "b"},
     {"op": "finish", "day": "2026-10-05", "session": "s1", "done": ["0-0"], "as": "a", "expect": "closed"},
     {"op": "load", "day": "2026-10-05", "expect": null},
     {"op": "signIn", "user": "a"},
     {"op": "finish", "day": "2026-10-05", "session": "s1", "done": ["0-0"], "expect": "ok"},
     {"op": "finish", "day": "2026-10-05", "session": "s2", "done": ["0-0"], "expect": "dayAlreadyLogged"},
     {"op": "load", "day": "2026-10-05", "expect": {"loggedSessionId": "s1"}}
   ]},
   "expected": {"owners": ["a"], "outbox": ["s1"]}}
]
