{
  "$schema": "https://example.com/ascnd/design-tokens.schema.json",
  "meta": {
    "name": "ASCND Design Tokens v0",
    "source": "native/src/constants/palette.ts (darkPalette/lightPalette), native/src/constants/ascnd.ts (spacing, radius, type)",
    "note": "Values are a faithful port of the React Native app. iOS SwiftUI reads these via ASCNDDesignSystem; do not hand-tune in Swift.",
    "issue": "#229"
  },
  "color": {
    "background": {
      "light": "#f7f4ef",
      "dark": "#070708"
    },
    "card": {
      "light": "#ffffff",
      "dark": "#0e0e11"
    },
    "secondary": {
      "light": "#efeae1",
      "dark": "#18181b"
    },
    "muted": {
      "light": "#f2eee7",
      "dark": "#161618"
    },
    "accent": {
      "light": "#e9e3d8",
      "dark": "#1d1d20"
    },
    "border": {
      "light": "#dcd5c8",
      "dark": "#2b2b31"
    },
    "input": {
      "light": "#f4f0e8",
      "dark": "#303036"
    },
    "ringTrack": {
      "light": "#c4bcac",
      "dark": "#3a3a42"
    },
    "foreground": {
      "light": "#1a1917",
      "dark": "#ededed"
    },
    "mutedForeground": {
      "light": "#6b6559",
      "dark": "#828282"
    },
    "mutedOnInset": {
      "light": "#6b6559",
      "dark": "#8b8b8b"
    },
    "glassMuted": {
      "light": "#5c564b",
      "dark": "#c8ccd4"
    },
    "secondaryForeground": {
      "light": "#57524a",
      "dark": "#999999"
    },
    "brand": {
      "light": "#525865",
      "dark": "#a8afbd"
    },
    "primary": {
      "light": "#1a1917",
      "dark": "#a8afbd"
    },
    "primaryForeground": {
      "light": "#ffffff",
      "dark": "#070708"
    },
    "goldLight": {
      "light": "#7d6733",
      "dark": "#c7cad1"
    },
    "champagne": {
      "light": "#6c6f79",
      "dark": "#9fa3ad"
    },
    "destructive": {
      "light": "#de0b44",
      "dark": "#ff3b5c"
    },
    "destructiveForeground": {
      "light": "#ffffff",
      "dark": "#ffffff"
    },
    "readinessGreen": {
      "light": "#078055",
      "dark": "#00c785"
    },
    "readinessYellow": {
      "light": "#846e06",
      "dark": "#cdac00"
    },
    "readinessYellowGraphic": {
      "light": "#a78b00",
      "dark": "#cdac00"
    },
    "readinessRed": {
      "light": "#de0b44",
      "dark": "#ff8d92"
    },
    "metricBlue": {
      "light": "#0673be",
      "dark": "#3ba6ff"
    },
    "waterFill": {
      "light": "#8ccbf0",
      "dark": "#8ccbf0"
    },
    "metricBlueWash": {
      "light": "#3ba6ff",
      "dark": "#3ba6ff"
    },
    "metricBlueInk": {
      "light": "#073a68",
      "dark": "#3ba6ff"
    },
    "recessBg": {
      "light": "#f7f9fa",
      "dark": "#070708"
    },
    "recessBorder": {
      "light": "#dce0e3",
      "dark": "#2b2b2f"
    },
    "metricPurple": {
      "light": "#8c35d0",
      "dark": "#b45cff"
    },
    "metricCyan": {
      "light": "#077b8b",
      "dark": "#22e3ff"
    },
    "metricOrange": {
      "light": "#ac5b06",
      "dark": "#ff9130"
    },
    "metricOrangeGraphic": {
      "light": "#d87300",
      "dark": "#ff9130"
    },
    "metricRose": {
      "light": "#b83044",
      "dark": "#e6485c"
    },
    "metricBeige": {
      "light": "#b28009",
      "dark": "#ffe6bd"
    },
    "metricViolet": {
      "light": "#7c52e3",
      "dark": "#8b5cff"
    },
    "metricSteel": {
      "light": "#5d728f",
      "dark": "#7f9cc4"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "card": 20,
    "stack": 20,
    "lg": 24,
    "xl": 32
  },
  "radius": {
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "full": 999
  },
  "typography": {
    "hero": {
      "fontSize": 44,
      "weight": 300,
      "letterSpacing": -1.2,
      "iosTextStyle": null,
      "note": "Answer number of a screen; light not bold (SF keeps shape at 44pt). Custom size above largeTitle."
    },
    "largeTitle": {
      "fontSize": 28,
      "weight": 700,
      "letterSpacing": -0.4,
      "iosTextStyle": "title1"
    },
    "title": {
      "fontSize": 22,
      "weight": 700,
      "letterSpacing": -0.3,
      "iosTextStyle": "title2"
    },
    "title2": {
      "fontSize": 18,
      "weight": 700,
      "letterSpacing": -0.2,
      "iosTextStyle": "title3",
      "note": "18pt sits between callout and title3; title3 (20pt) is the closest system style."
    },
    "headline": {
      "fontSize": 17,
      "weight": 600,
      "letterSpacing": -0.2,
      "iosTextStyle": "headline"
    },
    "body": {
      "fontSize": 15,
      "weight": 400,
      "iosTextStyle": "subheadline"
    },
    "footnote": {
      "fontSize": 13,
      "weight": 500,
      "iosTextStyle": "footnote"
    },
    "caption": {
      "fontSize": 11,
      "weight": 500,
      "iosTextStyle": "caption2"
    },
    "mono": {
      "fontFamily": "Menlo",
      "variant": "tabular-nums",
      "note": "Big metric read-outs that change live (rest timer, counters). Static hero numbers use hero + tabular-nums instead."
    }
  }
}
