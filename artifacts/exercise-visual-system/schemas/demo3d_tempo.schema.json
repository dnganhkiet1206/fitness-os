{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascnd.app/schemas/demo3d/demo3d_tempo.schema.json",
  "title": "Nhịp từng rep của một bài",
  "type": "object",
  "required": [
    "schema",
    "exercise",
    "duration_ms",
    "reps",
    "phases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "exercise": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "duration_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "notation": {
      "type": [
        "string",
        "null"
      ]
    },
    "reps": {
      "type": "integer",
      "minimum": 1
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rep",
          "kind",
          "start_ms",
          "end_ms"
        ],
        "additionalProperties": false,
        "properties": {
          "rep": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "ready",
              "concentric",
              "eccentric",
              "top_hold",
              "bottom_hold",
              "rest"
            ]
          },
          "start_ms": {
            "type": "number",
            "minimum": 0
          },
          "end_ms": {
            "type": "number",
            "minimum": 0
          },
          "breath": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
