# ── Backend ────────────────────────────────────────────────────────────
# Copy to `.env` and fill in when the real Supabase project is ready.
# Without this file the app falls back to the development project baked
# into src/lib/backend.ts, so a fresh clone still runs.
#
# The EXPO_PUBLIC_ prefix is required: Expo only inlines variables with it
# into the client bundle. A variable named without the prefix reads as
# undefined at runtime and silently falls back to the default.
#
# The anon (publishable) key is meant to ship in the client — row-level
# security is what governs access. It is not a secret.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<anon / publishable key>
